# Backend: set these in Render (never commit actual secrets)
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<random-secret-at-least-32-characters>
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://<storefront>.vercel.app
ADMIN_URL=https://<admin>.vercel.app
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<verified-sender@example.com>
BREVO_SENDER_NAME=Ergocraft Seating Pvt. Ltd.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# Vercel storefront environment variable
NEXT_PUBLIC_API_URL=https://<backend>.onrender.com/api/v1

NEXT_PUBLIC_SITE_URL=https://<storefront>.vercel.app

# Optional; defaults to BREVO_SENDER_EMAIL when omitted.
ORDER_NOTIFICATION_EMAIL=
