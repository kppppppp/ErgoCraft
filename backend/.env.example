NODE_ENV=development
PORT=5000
# Local development only. Set MONGO_URI in Render to the production Atlas database.
MONGO_URI=mongodb://127.0.0.1:27017/ergocraft
# Allowed CORS origins for browser credentialed requests.
# Supports single URL or multiple comma-separated URLs:
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Optional: comma-separated additional origins (e.g. production domains or Vercel URLs):
# ALLOWED_ORIGINS=https://ergocraft.vercel.app,https://ergocraft.in,https://www.ergocraft.in
# Optional: set to 'true' to allow all *.vercel.app preview deployment URLs:
# ALLOW_VERCEL_PREVIEWS=true
JWT_SECRET=ergocraft_dev_jwt_secret_key_needs_to_be_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ergocraft Seating Pvt. Ltd.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional; defaults to BREVO_SENDER_EMAIL when omitted.
ORDER_NOTIFICATION_EMAIL=
