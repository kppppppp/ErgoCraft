# ==============================================================================
# ErgoCraft Storefront — Environment Variables (.env.example)
# ==============================================================================
# Configure these variables in Vercel: Project Settings > Environment Variables
#
# Production API Base URL (Render backend):
# NEXT_PUBLIC_API_URL=https://ergocraft-1.onrender.com
#
# Local development default:
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production Site URL (Your deployed Vercel domain or custom domain):
# NEXT_PUBLIC_SITE_URL=https://your-storefront.vercel.app
#
# Local development default:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Razorpay Key ID (Client-side identifier only; NEVER expose the secret key):
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=

