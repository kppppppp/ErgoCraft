# ==============================================================================
# ErgoCraft Admin Panel — Environment Variables (.env.example)
# ==============================================================================
# In production on Vercel, configure these variables in Project Settings > Environment Variables:
#
# Production API Base URL (Render backend):
# NEXT_PUBLIC_API_URL=https://ergocraft-1.onrender.com
#
# Local development default:
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production Admin Site URL (Your deployed admin domain):
# NEXT_PUBLIC_SITE_URL=https://your-admin.vercel.app
#
# Local development default:
NEXT_PUBLIC_SITE_URL=http://localhost:3001

